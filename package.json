{
  "name": "oxford-his",
  "version": "0.0.0",
  "private": true,
  "description": "Oxford HIS \u2014 bilingual Hospital/Clinic Information System for Oxford Medical Kuwait",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "vitest",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "build": "pnpm -r build",
    "secret-scan": "node scripts/secret-scan.mjs",
    "boundaries": "node scripts/check-boundaries.mjs",
    "check-migrations-safe": "node scripts/check-migrations-safe.mjs",
    "check-cutover-invariants": "node scripts/check-cutover-invariants.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
