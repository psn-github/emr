{
  "name": "@oxford/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "build:server": "esbuild src/serve.ts src/migrate.ts src/simulator/simulate.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --entry-names=[name] --external:pg --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@oxford/analytics": "workspace:*",
    "@oxford/andrology": "workspace:*",
    "@oxford/assets": "workspace:*",
    "@oxford/audit": "workspace:*",
    "@oxford/billing": "workspace:*",
    "@oxford/clinical": "workspace:*",
    "@oxford/consent": "workspace:*",
    "@oxford/core": "workspace:*",
    "@oxford/cryostore": "workspace:*",
    "@oxford/crypto": "workspace:*",
    "@oxford/documents": "workspace:*",
    "@oxford/embryology": "workspace:*",
    "@oxford/facility": "workspace:*",
    "@oxford/fertility": "workspace:*",
    "@oxford/hr": "workspace:*",
    "@oxford/i18n": "workspace:*",
    "@oxford/identity": "workspace:*",
    "@oxford/inventory": "workspace:*",
    "@oxford/messaging": "workspace:*",
    "@oxford/migration": "workspace:*",
    "@oxford/notifications": "workspace:*",
    "@oxford/outcomes": "workspace:*",
    "@oxford/perioperative": "workspace:*",
    "@oxford/pharmacy": "workspace:*",
    "@oxford/print": "workspace:*",
    "@oxford/push": "workspace:*",
    "@oxford/records": "workspace:*",
    "@oxford/registry": "workspace:*",
    "@oxford/scheduling": "workspace:*",
    "@oxford/witnessing": "workspace:*",
    "@trpc/server": "^11.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@trpc/client": "^11.0.0",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.0"
  }
}
